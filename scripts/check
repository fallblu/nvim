#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_dir"

nvim_bin="${NVIM_BIN:-nvim}"
if ! command -v "$nvim_bin" >/dev/null 2>&1; then
  printf 'Neovim executable not found: %s\n' "$nvim_bin" >&2
  exit 1
fi

nvim_data="$("$nvim_bin" --headless -u NONE -c 'lua io.write(vim.fn.stdpath("data"))' -c 'qa!' 2>/dev/null)"
nvim_runtime="$("$nvim_bin" --headless -u NONE -c 'lua io.write(vim.env.VIMRUNTIME)' -c 'qa!' 2>/dev/null)"

resolve_tool() {
  local tool_name="$1"
  local tool_path
  tool_path="$(command -v "$tool_name" 2>/dev/null || true)"
  if [[ -z "$tool_path" && -x "$nvim_data/mason/bin/$tool_name" ]]; then
    tool_path="$nvim_data/mason/bin/$tool_name"
  fi
  if [[ -z "$tool_path" ]]; then
    printf 'Required check tool not found: %s\n' "$tool_name" >&2
    return 1
  fi
  printf '%s\n' "$tool_path"
}

stylua_bin="$(resolve_tool stylua)"
lua_ls_bin="$(resolve_tool lua-language-server)"

printf '%s\n' 'Checking shell and diff hygiene...'
bash -n scripts/check
git diff --check

printf '%s\n' 'Checking Lua formatting...'
"$stylua_bin" --check init.lua lua tests

printf '%s\n' 'Checking Lua diagnostics...'
env VIMRUNTIME="$nvim_runtime" "$lua_ls_bin" --check=. --check_format=pretty --checklevel=Warning

printf '%s\n' 'Running Neovim smoke tests...'
"$nvim_bin" --headless -c 'luafile tests/smoke.lua'

printf '\n%s\n' 'Running configuration health checks...'
"$nvim_bin" --headless -c 'checkhealth garrett' -c 'luafile tests/health.lua'
